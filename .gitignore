.env
.env.*
!.env.example

# Node dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production build outputs
dist/
build/
*/dist/
*/build/

# Testing coverage
coverage/

# OS and Editor files
.DS_Store
Thumbs.db
